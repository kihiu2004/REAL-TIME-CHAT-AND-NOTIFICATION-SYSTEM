# Application
APP_NAME=ConnectHub
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# Database (XAMPP MySQL)
DATABASE_URL=mysql+aiomysql://root:@localhost:3306/connecthub?charset=utf8mb4

# JWT (generate a long random value, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# bcrypt cost (4-31). 12 is a good production default; tests use 4.
BCRYPT_ROUNDS=12

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS (JSON list)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
